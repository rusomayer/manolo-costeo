# ─────────────────────────────────────────────────────────────────

# ─── Anthropic ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Supabase ───────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Si usás storage cifrado de integraciones (patrón agent-agency):
# INTEGRATIONS_ENCRYPTION_KEY=  # 32 bytes base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# ─── Telegram (opcional) ────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_CHAT_ID=

# ─── Twilio WhatsApp (opcional) ─────────────────────────────────
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=  # ej: whatsapp:+14155238886

# ─── OpenAI (opcional, para Whisper / ImageGen) ─────────────────
# OPENAI_API_KEY=

# ─── Replicate / video / image gen (opcional) ───────────────────
# REPLICATE_API_TOKEN=

# ─── Vercel / deploy ────────────────────────────────────────────
